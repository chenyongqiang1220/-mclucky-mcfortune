{
  "name": "maimen-daily-fortune",
  "version": "1.0.0",
  "private": true,
  "description": "麦门今日运势 —— 每日一签点餐搭子。选心情、定预算、定位，一键生成今日麦门签（签等级 + 签文 + 宜忌 + 推荐套餐 + 最省券组合 + 附近门店），并生成 750x1334 竖版签图分享。",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "tools": "node -e \"require('dotenv').config();const{McpClient}=require('./server/mcp-client');(async()=>{const c=new McpClient({token:process.env.MCP_TOKEN});await c.initialize();const t=await c.listTools();console.log(t.map(x=>x.name).join('\\n'));})()\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "keywords": [
    "麦当劳",
    "MCP",
    "麦门",
    "今日运势",
    "1024程序员节"
  ],
  "license": "MIT"
}
